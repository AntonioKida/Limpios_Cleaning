# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local Claude Code settings (per-user, not shared)
.claude/settings.local.json

# audit artifacts (keep harness scripts + results.json; ignore heavy screenshots)
/audit/screenshots
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lighthouse run artifacts
.lh-*.json
.next-start.log

# Round 2.1 source media (kept out of Git per brief; optimized derivatives live in /public)
/Media
# Raw/source video clips — uploaded to YouTube/Vimeo, NOT served from the repo
# (facade embeds via TODO URLs). Posters in /public/video-posters ARE committed.
/public/Youtube
/public/trimmed

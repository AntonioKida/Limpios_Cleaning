# ---------------------------------------------------------------------------
# Limpios Cleaning — environment variables
# Copy to `.env.local` and fill in. NEVER commit real keys (.env* is gitignored).
# In dev with no RESEND_API_KEY, lead submissions are logged to the server
# console and the UI still shows success — nothing breaks without these.
# ---------------------------------------------------------------------------

# Resend API key for sending lead-notification emails.
# Get one at https://resend.com. Leave blank for local dev (console logging).
RESEND_API_KEY=

# Inbox that receives new quote requests (defaults to info@limpioscleaning.com).
LEAD_NOTIFICATION_EMAIL=info@limpioscleaning.com

# "From" sender for lead emails. Must be a verified domain sender in production.
# TODO: replace with e.g. "Limpios Cleaning <quotes@limpioscleaning.com>".
LEAD_FROM_EMAIL="Limpios Cleaning <onboarding@resend.dev>"

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to disable GA. Vercel Analytics works without any key.
NEXT_PUBLIC_GA_ID=
